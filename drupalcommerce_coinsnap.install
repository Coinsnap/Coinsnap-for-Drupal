<?php

use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_install().
 */
function drupalcommerce_coinsnap_install() {

    // A new installation has no orders from before invoices were recorded.
    \Drupal::state()->set('drupalcommerce_coinsnap.legacy_until', time());

    if (!FieldStorageConfig::loadByName('commerce_order', 'field_payment_gateway')) {
        FieldStorageConfig::create([
            'field_name' => 'field_payment_gateway',
            'entity_type' => 'commerce_order',
            'type' => 'string',
            'cardinality' => 1,
        ])->save();
    }

    if (!FieldConfig::loadByName('commerce_order', 'default', 'field_payment_gateway')) {
        FieldConfig::create([
            'field_name' => 'field_payment_gateway',
            'entity_type' => 'commerce_order',
            'bundle' => 'default',
            'label' => 'Payment Gateway',
        ])->save();
    }
}

/**
 * Orders started before 1.2.0 have no invoice record: accept their webhooks for one more day only.
 */
function drupalcommerce_coinsnap_update_10200() {
    if (\Drupal::state()->get('drupalcommerce_coinsnap.legacy_until') === null) {
        \Drupal::state()->set('drupalcommerce_coinsnap.legacy_until', time() + 86400);
    }
    return t('Coinsnap: webhooks for orders without an invoice record are accepted for 24 hours. Open each Coinsnap payment gateway, check "Site address for the webhook" and save it, so its webhook is registered again.');
}

/**
 * Implements hook_uninstall().
 */
function drupalcommerce_coinsnap_uninstall() {
    \Drupal::state()->delete('drupalcommerce_coinsnap.legacy_until');
}
